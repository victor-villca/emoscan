{
  "manifest_version": 3,
  "name": "EmoScan Meet Helper",
  "version": "1.0.1",
  "description": "Detección de rostros en videollamadas de Google Meet",
  "permissions": ["scripting", "activeTab", "tabs"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_icon": "assets/icon.png",
    "default_title": "Iniciar EmoScan"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "ui/*",
        "assets/*",
        "js/face-api.min.js",
        "js/models/*",
        "content/controllers/*"
      ],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}
