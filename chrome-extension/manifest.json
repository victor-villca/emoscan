{
  "manifest_version": 3,
  "name": "EmoScan Meet Helper",
  "version": "1.0",
  "description": "Activa detección de rostros en videollamadas de Google Meet.",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["https://meet.google.com/*"],
  "action": {
    "default_icon": "assets/icon.png",
    "default_title": "Iniciar panel de detección"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "icons": {
    "16": "assets/icon.png",
    "48": "assets/icon.png",
    "128": "assets/icon.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["ui/*", "assets/*"],
      "matches": ["https://meet.google.com/*"]
    }
  ]
}